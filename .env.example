# ============================================================
# Personal Vault — Environment Variables Template
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to version control.
# ============================================================

# Your Google OAuth 2.0 Web Client ID
# Get it from: https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# The ONLY Gmail address allowed to sign in (single-user lock)
VITE_ALLOWED_EMAIL=your@gmail.com
